# Copy this file to .env and fill in your own values. Never commit .env.

# ---------- Core ----------
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/dara?retryWrites=true&w=majority
# Storefront origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173
# Set to 1 behind a reverse proxy / load balancer (correct client IPs for rate limiting)
TRUST_PROXY=0

# ---------- Sessions ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
OTP_SECRET=
SESSION_DAYS=7
# Production defaults to secure cookies. If the API and storefront are on different sites,
# set COOKIE_SAMESITE=none (requires HTTPS).
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---------- Email (sign-up codes, password resets, order confirmations) ----------
# "brevo" (Brevo API), "smtp", or "console" (prints emails to the server log — development only)
EMAIL_TRANSPORT=console
# Brevo: SMTP & API → API Keys; the sender must be verified under Senders & Domains
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DARA Fashions
# SMTP (only when EMAIL_TRANSPORT=smtp) — Amazon SES, Resend or any SMTP host
EMAIL_FROM=DARA Fashions <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Payments ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks: URL https://<api-domain>/api/payments/razorpay/webhook
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=
# Cash on Delivery — only if the business offers it
ENABLE_COD=false

# ---------- Admin ----------
# Comma-separated emails that get the admin role when they log in
ADMIN_EMAILS=

# ---------- Uploads ----------
# Where admin-uploaded images are stored (default: server/uploads). Back this folder up.
UPLOAD_DIR=

# ---------- Storefront content (optional; blank values are hidden on the site) ----------
ANNOUNCEMENTS=Discover the Latest Jewellery Trends|New Arrivals — Explore the Collection|Celebrate Every Occasion with DARA
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP=
CONTACT_ADDRESS=
CONTACT_HOURS=
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_PINTEREST=
SHIPPING_FREE_THRESHOLD=999
SHIPPING_STANDARD_FEE=79
SHIPPING_EXPRESS_FEE=199
SHIPPING_STANDARD_ETA=3–7 business days
SHIPPING_EXPRESS_ETA=1–3 business days
BREVO_API_KEY=apiKey
BREVO_SENDER_EMAIL=senthilmurugan4816@gmail.com
