{
  "name": "dara-fashions-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node scripts/dev-memory.js",
    "seed": "node src/seed/seed.js",
    "check": "node --check src/server.js && node scripts/check-syntax.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "seed:catalog": "node src/seed/seed.js --catalog-only"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
